{
    "name": "betoalien/lyger-v0.2",
    "description": "Lyger Framework v0.2 - PHP with the production Rust FFI bridge",
    "keywords": ["framework", "lyger", "rust", "ffi", "performance", "zero-copy", "async"],
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alberto Cardenas",
            "email": "betoalien@gmail.com",
            "role": "Creator & Architect"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        },
        "classmap": [
            "Lyger/"
        ],
        "exclude-from-classmap": [
            "Lyger/Database/HasOne.php"
        ]
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php rawr install"
        ],
        "post-install-cmd": [
            "@php rawr core:download-binaries"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
